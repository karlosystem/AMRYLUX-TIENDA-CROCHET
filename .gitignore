# ==================== IMÁGENES DE PRODUCTOS (solo las de assest/products) ====================
# Excluir imágenes de productos de prueba (no las del proyecto real)
frontend/src/assest/products/**/*.png
frontend/src/assest/products/**/*.jpg
frontend/src/assest/products/**/*.jpeg
frontend/src/assest/products/**/*.webp

# ==================== PERMITIR IMÁGENES IMPORTANTES DEL PROYECTO ====================
# Estas SÍ deben subirse al repositorio
